generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum GameItemType {
  team
  character
  map
  class
  weapon
  other
}

enum MatchResult {
  win
  loss
  draw
}

enum PesMatchStage {
  group
  final
  repechage
}

enum UserRole {
  admin
  user
}

enum UserPermissionType {
  manage_players
  manage_games
  manage_items
  manage_raffles
  manage_matches
  view_stats
  manage_users
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String
  role         UserRole         @default(user)
  playerId     String?          @unique
  player       Player?          @relation(fields: [playerId], references: [id], onDelete: SetNull)
  active       Boolean          @default(true)
  permissions  UserPermission[]
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([role, active])
  @@map("users")
}

model UserPermission {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission UserPermissionType
  createdAt  DateTime           @default(now())

  @@unique([userId, permission])
  @@index([permission])
  @@map("user_permissions")
}

model Group {
  id            String           @id @default(cuid())
  name          String
  players       Player[]
  matches       Match[]
  raffleHistory RaffleHistory[]
  pesSessions   PesGameSession[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("groups")
}

model Player {
  id                           String               @id @default(cuid())
  name                         String
  nickname                     String?
  age                          Int?
  photoUrl                     String?
  coverUrl                     String?
  groupId                      String?
  group                        Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  user                         User?
  matchPlayers                 MatchPlayer[]
  raffleHistory                RaffleHistory[]
  pesParticipants              PesGameParticipant[]
  pesStandings                 PesGameStanding[]
  pesChampionSessions          PesGameSession[]     @relation("PesChampion")
  pesRepechageChampionSessions PesGameSession[]     @relation("PesRepechageChampion")
  pesMatchesAsPlayer1          PesGameMatch[]       @relation("PesMatchPlayer1")
  pesMatchesAsPlayer2          PesGameMatch[]       @relation("PesMatchPlayer2")
  pesMatchesWon                PesGameMatch[]       @relation("PesMatchWinner")
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  @@index([groupId])
  @@map("players")
}

model Game {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String?
  items         GameItem[]
  matches       Match[]
  raffleHistory RaffleHistory[]
  pesSessions   PesGameSession[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("games")
}

model GameItem {
  id              String               @id @default(cuid())
  gameId          String
  game            Game                 @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name            String
  type            GameItemType
  groupName       String?
  imageUrl        String?
  active          Boolean              @default(true)
  matchPlayers    MatchPlayer[]
  raffleHistory   RaffleHistory[]
  pesParticipants PesGameParticipant[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([gameId, type, active])
  @@index([gameId, type, groupName, active])
  @@map("game_items")
}

model Match {
  id          String        @id @default(cuid())
  groupId     String?
  group       Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  gameId      String
  game        Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  externalRef String?       @unique
  date        DateTime      @default(now())
  description String?
  players     MatchPlayer[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([groupId])
  @@index([gameId, date])
  @@map("matches")
}

model MatchPlayer {
  id             String       @id @default(cuid())
  matchId        String
  match          Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId       String
  player         Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  selectedItemId String?
  selectedItem   GameItem?    @relation(fields: [selectedItemId], references: [id], onDelete: SetNull)
  teamName       String?
  result         MatchResult?
  score          Int?
  kills          Int?
  deaths         Int?
  assists        Int?
  goals          Int?
  goalsAgainst   Int?
  knifeKills     Int?
  headshots      Int?
  damage         Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([matchId])
  @@index([playerId])
  @@index([selectedItemId])
  @@map("match_players")
}

model RaffleHistory {
  id        String    @id @default(cuid())
  drawId    String?
  groupId   String?
  group     Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  gameId    String
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId  String?
  player    Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  itemId    String?
  item      GameItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  groupName String?
  createdAt DateTime  @default(now())

  @@index([drawId])
  @@index([groupId])
  @@index([gameId, createdAt])
  @@index([playerId])
  @@index([itemId])
  @@map("raffle_history")
}

model PesGameSession {
  id                        String               @id @default(cuid())
  name                      String               @default("PES")
  gameId                    String
  game                      Game                 @relation(fields: [gameId], references: [id], onDelete: Cascade)
  groupId                   String?
  group                     Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  active                    Boolean              @default(true)
  useRepechage              Boolean              @default(false)
  matchIdCounter            Int                  @default(1)
  championPlayerId          String?
  championPlayer            Player?              @relation("PesChampion", fields: [championPlayerId], references: [id], onDelete: SetNull)
  repechageChampionPlayerId String?
  repechageChampionPlayer   Player?              @relation("PesRepechageChampion", fields: [repechageChampionPlayerId], references: [id], onDelete: SetNull)
  groups                    PesGameGroup[]
  participants              PesGameParticipant[]
  matches                   PesGameMatch[]
  standings                 PesGameStanding[]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@index([gameId, active])
  @@index([groupId, active])
  @@map("pes_game_sessions")
}

model PesGameGroup {
  id           String         @id @default(cuid())
  sessionId    String
  session      PesGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stateGroupId String
  letter       String
  groupIndex   Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([sessionId, stateGroupId])
  @@unique([sessionId, letter])
  @@index([sessionId, groupIndex])
  @@map("pes_game_groups")
}

model PesGameParticipant {
  id          String         @id @default(cuid())
  sessionId   String
  session     PesGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId    String
  player      Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamItemId  String?
  teamItem    GameItem?      @relation(fields: [teamItemId], references: [id], onDelete: SetNull)
  groupLetter String
  groupIndex  Int
  position    Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([sessionId, playerId])
  @@index([sessionId, groupLetter])
  @@index([playerId])
  @@index([teamItemId])
  @@map("pes_game_participants")
}

model PesGameMatch {
  id             String         @id
  sessionId      String
  session        PesGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stage          PesMatchStage
  round          Int
  stateGroupId   String?
  groupLetter    String?
  groupIndex     Int?
  matchIndex     Int
  player1Id      String?
  player1        Player?        @relation("PesMatchPlayer1", fields: [player1Id], references: [id], onDelete: SetNull)
  player2Id      String?
  player2        Player?        @relation("PesMatchPlayer2", fields: [player2Id], references: [id], onDelete: SetNull)
  player1Name    String
  player2Name    String
  goals1         Int?
  goals2         Int?
  pen1           Int?
  pen2           Int?
  winnerPlayerId String?
  winnerPlayer   Player?        @relation("PesMatchWinner", fields: [winnerPlayerId], references: [id], onDelete: SetNull)
  draw           Boolean        @default(false)
  isFinished     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([sessionId, stage, round, matchIndex])
  @@index([player1Id])
  @@index([player2Id])
  @@index([winnerPlayerId])
  @@map("pes_game_matches")
}

model PesGameStanding {
  id                String         @id @default(cuid())
  sessionId         String
  session           PesGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId          String
  player            Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  groupLetter       String
  position          Int
  points            Int            @default(0)
  wins              Int            @default(0)
  draws             Int            @default(0)
  losses            Int            @default(0)
  goalsFor          Int            @default(0)
  goalsAgainst      Int            @default(0)
  goalDifference    Int            @default(0)
  qualified         Boolean        @default(false)
  repechageEligible Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([sessionId, playerId])
  @@index([sessionId, groupLetter, position])
  @@index([playerId])
  @@map("pes_game_standings")
}
