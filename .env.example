# Sorteador Times - exemplo de .env
# Copie para .env no servidor:
#   cp .env.example .env
#   nano .env
#
# IMPORTANTE:
# - Em producao o MySQL fica FORA do Docker deste projeto.
# - O docker-compose.yml sobe apenas app + nginx + volume de uploads.
# - Se o MySQL estiver instalado na propria VPS, use host.docker.internal
#   como host do banco dentro do container.

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# URL publica final da aplicacao.
# Em producao, use HTTPS para o cookie sair com Secure.
NEXT_PUBLIC_APP_URL=https://seu-dominio.com

# ---------------------------------------------------------------------------
# Banco de dados MySQL externo
# ---------------------------------------------------------------------------
# Opcao A - MySQL instalado na propria VPS, fora do Docker:
# DATABASE_URL="mysql://sorteador_user:SENHA_FORTE@host.docker.internal:3306/sorteador_times"
#
# Opcao B - MySQL gerenciado/externo:
# DATABASE_URL="mysql://sorteador_user:SENHA_FORTE@HOST_DO_BANCO:3306/sorteador_times"
#
DATABASE_URL="mysql://sorteador_user:SENHA_FORTE@host.docker.internal:3306/sorteador_times"

# ---------------------------------------------------------------------------
# Autenticacao
# ---------------------------------------------------------------------------
# Gere um segredo longo no SSH, por exemplo:
#   openssl rand -base64 48
AUTH_JWT_SECRET=troque_por_um_segredo_longo_gerado_com_openssl

# Usuario administrador criado/atualizado pelo seed.
AUTH_ADMIN_NAME=Administrador
AUTH_ADMIN_EMAIL=admin@seu-dominio.com
AUTH_ADMIN_PASSWORD=troque_por_uma_senha_forte

# ---------------------------------------------------------------------------
# Somente para desenvolvimento local com MySQL em container
# ---------------------------------------------------------------------------
# Usado apenas com:
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
# O override usa variaveis LOCAL_* para nao confundir com as variaveis de producao.
# LOCAL_DATABASE_URL="mysql://sorteador_user:change_me@db:3306/sorteador_times"
# LOCAL_NEXT_PUBLIC_APP_URL=http://localhost:8082
# LOCAL_AUTH_JWT_SECRET=change_this_to_a_long_random_secret
# LOCAL_AUTH_ADMIN_EMAIL=admin@sorteador.local
# LOCAL_AUTH_ADMIN_PASSWORD=change_me_admin_123
MYSQL_DATABASE=sorteador_times
MYSQL_USER=sorteador_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me
MYSQL_PORT=3307
